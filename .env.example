# Copy to .env for local runs (never commit .env). In GitHub these go in
# Settings -> Secrets and variables -> Actions.

# --- Secrets ---
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=
RESEND_API_KEY=
REPORT_RECIPIENTS=            # comma-separated
ALERT_EMAIL=                  # where "updates stopped" alerts go
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
XANO_API_TOKEN=

# --- Variables (not secret) ---
SITE_URL=https://constructionweather.us
REPORT_FROM="Vineland Weather Log <reports@reports.constructionweather.us>"
NWS_USER_AGENT="(constructionweather.us, ops@constructionweather.us)"
PUBLISH_LIGHTNING_EVENTS=false
PROCORE_MODE=off              # off | dry-run | live
PROCORE_ENV=sandbox           # sandbox | production
PROCORE_COMPANY_ID=
PROCORE_PROJECT_ID=
PROCORE_FOLDER_ID=
XANO_META_URL=                # e.g. https://xxxx-xxxx-xxxx.n7.xano.io/api:meta
XANO_WORKSPACE_ID=
XANO_TABLE_ID=
